#include <stdio.h>

int main() {
    float mem, tlb, hit, noTLB, withTLB;

    printf("Memory Access Time: ");
    scanf("%f", &mem);

    printf("TLB Access Time: ");
    scanf("%f", &tlb);

    printf("TLB Hit Ratio (0-1): ");
    scanf("%f", &hit);

    noTLB = 2 * mem;
    withTLB = hit * (tlb + mem) + (1 - hit) * (tlb + 2 * mem);

    printf("Without TLB = %.2f ns\n", noTLB);
    printf("With TLB = %.2f ns\n", withTLB);

    return 0;
}


