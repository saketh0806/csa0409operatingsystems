#include <stdio.h>

int main() {
    int base, limit, logical;

    printf("Base: ");
    scanf("%d", &base);

    printf("Limit: ");
    scanf("%d", &limit);

    printf("Logical Address: ");
    scanf("%d", &logical);

    if (logical < limit)
        printf("Physical Address = %d", base + logical);
    else
        printf("Invalid Address");

    return 0;
}

