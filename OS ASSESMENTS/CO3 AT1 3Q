#include <stdio.h>

int main() {
    int pt[5], page, offset, i;

    printf("Enter 5 frame numbers:\n");
    for(i = 0; i < 5; i++)
        scanf("%d", &pt[i]);

    printf("Enter Page Number: ");
    scanf("%d", &page);

    printf("Enter Offset: ");
    scanf("%d", &offset);

    if(page < 5)
        printf("Frame = %d\nPhysical Address = %d", pt[page], pt[page] * 100 + offset);
    else
        printf("Invalid Page Number");

    return 0;
}


