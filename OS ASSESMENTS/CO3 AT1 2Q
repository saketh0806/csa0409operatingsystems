#include <stdio.h>

int main() {
    int pageTable[5] = {2, 5, 1, 4, 3};
    int page, offset, frame;

    printf("Page Number: ");
    scanf("%d", &page);

    printf("Offset: ");
    scanf("%d", &offset);

    if (page < 5) {
        frame = pageTable[page];
        printf("Physical Address = %d\n", frame * 100 + offset);
    } else {
        printf("Invalid Page Number");
    }

    return 0;
}


