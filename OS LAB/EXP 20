#include<stdio.h>
#include<fcntl.h>
#include<unistd.h>
#include<sys/stat.h>
#include<dirent.h>

int main()
{
int fd;
struct stat s;
DIR *d;
struct dirent *p;

fd=open("file.txt",O_CREAT|O_RDWR,0644);
write(fd,"Hello OS",8);

printf("File descriptor: %d\n",fcntl(fd,F_GETFD));

lseek(fd,0,SEEK_SET);
fstat(fd,&s);
printf("File size: %ld bytes\n",s.st_size);

close(fd);

d=opendir(".");
printf("Files:\n");
while((p=readdir(d))!=NULL)
printf("%s\n",p->d_name);

closedir(d);
return 0;
}
