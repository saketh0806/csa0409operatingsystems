#include<stdio.h>
#include<pthread.h>
#include<semaphore.h>

sem_t s;
int data=10;

void *reader(void *p)
{
sem_wait(&s);
printf("Reader reads %d\n",data);
sem_post(&s);
}

void *writer(void *p)
{
sem_wait(&s);
data=20;
printf("Writer writes %d\n",data);
sem_post(&s);
}

int main()
{
pthread_t r,w;
sem_init(&s,0,1);
pthread_create(&r,0,reader,0);
pthread_join(r,0);
pthread_create(&w,0,writer,0);
pthread_join(w,0);
}
