#include <stdio.h>

int main()
{
    int p[5] = {1,2,3,4,5};
    int bt[5] = {5,3,8,6,2};
    int pr[5] = {2,1,4,3,5};
    int wt[5], tat[5];
    int i, j, temp;
    float avg_wt = 0, avg_tat = 0;

    // Sort by Priority
    for(i=0;i<5;i++)
    {
        for(j=i+1;j<5;j++)
        {
            if(pr[i] > pr[j])
            {
                temp=pr[i]; pr[i]=pr[j]; pr[j]=temp;

                temp=bt[i]; bt[i]=bt[j]; bt[j]=temp;

                temp=p[i]; p[i]=p[j]; p[j]=temp;
            }
        }
    }

    wt[0]=0;

    for(i=1;i<5;i++)
        wt[i]=wt[i-1]+bt[i-1];

    for(i=0;i<5;i++)
        tat[i]=wt[i]+bt[i];

    printf("PID\tPriority\tBT\tWT\tTAT\n");

    for(i=0;i<5;i++)
    {
        printf("P%d\t%d\t\t%d\t%d\t%d\n",p[i],pr[i],bt[i],wt[i],tat[i]);
        avg_wt+=wt[i];
        avg_tat+=tat[i];
    }

    printf("\nAverage Waiting Time = %.2f",avg_wt/5);
    printf("\nAverage Turnaround Time = %.2f",avg_tat/5);

    return 0;
}
