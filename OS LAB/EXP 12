#include<stdio.h>
int main()
{
int a[3][3]={{1,1,2},{2,1,1},{1,2,1}};
int m[3][3]={{3,2,2},{3,3,2},{2,3,3}};
int v[3]={3,3,2},n[3][3],f[3]={0},s[3],i,j,k,c=0;

for(i=0;i<3;i++)
for(j=0;j<3;j++)
n[i][j]=m[i][j]-a[i][j];

while(c<3)
for(i=0;i<3;i++)
if(!f[i])
{
for(j=0;j<3;j++)
if(n[i][j]>v[j]) break;
if(j==3)
{
for(k=0;k<3;k++) v[k]+=a[i][k];
s[c++]=i;
f[i]=1;
}
}
printf("Safe Sequence: ");
for(i=0;i<3;i++) printf("P%d ",s[i]);
}
