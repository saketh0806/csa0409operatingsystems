#include <stdio.h>

int main()
{
    int pages[8] = {1, 2, 3, 1, 4, 5, 2, 1};
    int frame[3] = {-1, -1, -1};
    int i, j, k = 0, found;

    for(i = 0; i < 8; i++)
    {
        found = 0;

        for(j = 0; j < 3; j++)
        {
            if(frame[j] == pages[i])
                found = 1;
        }

        if(found == 0)
        {
            frame[k] = pages[i];
            k = (k + 1) % 3;
        }

        printf("Page %d : ", pages[i]);

        for(j = 0; j < 3; j++)
            printf("%d ", frame[j]);

        printf("\n");
    }

    return 0;
}
