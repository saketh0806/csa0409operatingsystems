#include <stdio.h>

int main()
{
    int bt[5]={6,2,8,3,4};
    int p[5]={1,2,3,4,5};
    int wt[5],tat[5];
    int i,j,temp;
    float avg_wt=0,avg_tat=0;

    // Sort by Burst Time
    for(i=0;i<5;i++)
    {
        for(j=i+1;j<5;j++)
        {
            if(bt[i]>bt[j])
            {
                temp=bt[i];
                bt[i]=bt[j];
                bt[j]=temp;

                temp=p[i];
                p[i]=p[j];
                p[j]=temp;
            }
        }
    }

    wt[0]=0;

    for(i=1;i<5;i++)
        wt[i]=wt[i-1]+bt[i-1];

    for(i=0;i<5;i++)
        tat[i]=wt[i]+bt[i];

    printf("PID\tBT\tWT\tTAT\n");

    for(i=0;i<5;i++)
    {
        printf("P%d\t%d\t%d\t%d\n",p[i],bt[i],wt[i],tat[i]);
        avg_wt+=wt[i];
        avg_tat+=tat[i];
    }

    printf("\nAverage Waiting Time = %.2f",avg_wt/5);
    printf("\nAverage Turnaround Time = %.2f",avg_tat/5);

    return 0;
}
