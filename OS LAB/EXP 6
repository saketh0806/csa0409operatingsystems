#include <stdio.h>

int main()
{
    int bt[5]={5,3,4,2,1};
    int rt[5],pr[5]={2,1,3,2,1};
    int wt[5],tat[5];
    int i,time=0,completed=0,min,index;
    float avg_wt=0,avg_tat=0;

    for(i=0;i<5;i++)
        rt[i]=bt[i];

    while(completed<5)
    {
        min=999;
        index=-1;

        for(i=0;i<5;i++)
        {
            if(rt[i]>0 && pr[i]<min)
            {
                min=pr[i];
                index=i;
            }
        }

        rt[index]--;
        time++;

        if(rt[index]==0)
        {
            completed++;
            tat[index]=time;
            wt[index]=tat[index]-bt[index];
        }
    }

    printf("PID\tBT\tPR\tWT\tTAT\n");

    for(i=0;i<5;i++)
    {
        printf("P%d\t%d\t%d\t%d\t%d\n",i+1,bt[i],pr[i],wt[i],tat[i]);
        avg_wt+=wt[i];
        avg_tat+=tat[i];
    }

    printf("\nAverage Waiting Time = %.2f",avg_wt/5);
    printf("\nAverage Turnaround Time = %.2f",avg_tat/5);

    return 0;
}
