#include<stdio.h>
#include<fcntl.h>
#include<unistd.h>

int main()
{
int fd;
char text[]="Operating System";

fd=open("file.txt",O_CREAT|O_WRONLY,0644);
write(fd,text,sizeof(text)-1);
close(fd);

fd=open("file.txt",O_RDONLY);
read(fd,text,sizeof(text)-1);
printf("File content: %s\n",text);
close(fd);

return 0;
}
