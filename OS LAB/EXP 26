#include <stdio.h>

int main()
{
    FILE *f;
    char data[] = "Hello File";

    f = fopen("file.txt", "w");

    fprintf(f, "%s", data);

    fclose(f);

    printf("File created\n");

    f = fopen("file.txt", "r");

    printf("File contents:\n");

    while(!feof(f))
        putchar(fgetc(f));

    fclose(f);

    return 0;
}
