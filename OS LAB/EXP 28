#include <stdio.h>

int main()
{
    char text[5][50] = {
        "Hello world",
        "Operating System",
        "Hello UNIX",
        "C Programming",
        "Hello students"
    };

    char word[] = "Hello";
    int i, j, found;

    for(i = 0; i < 5; i++)
    {
        found = 0;

        for(j = 0; text[i][j] != '\0'; j++)
        {
            if(text[i][j] == word[0])
            {
                if(text[i][j+1] == word[1] &&
                   text[i][j+2] == word[2] &&
                   text[i][j+3] == word[3] &&
                   text[i][j+4] == word[4])
                {
                    found = 1;
                }
            }
        }

        if(found)
            printf("%s\n", text[i]);
    }

    return 0;
}
