#include<stdio.h>
#include<pthread.h>

int x=0;
pthread_mutex_t m;

void *fun(void *p)
{
int i;
for(i=0;i<5;i++)
{
pthread_mutex_lock(&m);
x++;
printf("Count = %d\n",x);
pthread_mutex_unlock(&m);
}
}

int main()
{
pthread_t a,b;
pthread_mutex_init(&m,0);
pthread_create(&a,0,fun,0);
pthread_create(&b,0,fun,0);
pthread_join(a,0);
pthread_join(b,0);
printf("Final Count = %d",x);
}
