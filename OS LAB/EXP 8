#include <stdio.h>

int main()
{
    int bt[5]={10,5,8,6,2};
    int rt[5],wt[5],tat[5];
    int i,time=0,remain=5,tq=2;
    float avg_wt=0,avg_tat=0;

    for(i=0;i<5;i++)
        rt[i]=bt[i];

    while(remain>0)
    {
        for(i=0;i<5;i++)
        {
            if(rt[i]>0)
            {
                if(rt[i]<=tq)
                {
                    time+=rt[i];
                    rt[i]=0;
                    remain--;
                    tat[i]=time;
                    wt[i]=tat[i]-bt[i];
                }
                else
                {
                    rt[i]-=tq;
                    time+=tq;
                }
            }
        }
    }

    printf("PID\tBT\tWT\tTAT\n");

    for(i=0;i<5;i++)
    {
        printf("P%d\t%d\t%d\t%d\n",i+1,bt[i],wt[i],tat[i]);
        avg_wt+=wt[i];
        avg_tat+=tat[i];
    }

    printf("\nTime Quantum = %d",tq);
    printf("\nAverage Waiting Time = %.2f",avg_wt/5);
    printf("\nAverage Turnaround Time = %.2f",avg_tat/5);

    return 0;
}
