#include <stdio.h>

int buffer[5];
int in = 0, out = 0;

int main()
{
    int i;

    printf("Producer produces:\n");

    for(i = 1; i <= 5; i++)
    {
        buffer[in] = i * 10;
        printf("Produced %d\n", buffer[in]);
        in++;
    }

    printf("\nConsumer consumes:\n");

    for(i = 0; i < 5; i++)
    {
        printf("Consumed %d\n", buffer[out]);
        out++;
    }

    return 0;
}
